#!/usr/bin/env bash

FONT_NAME="Hack Nerd Font"

if [[ "$PLATFORM" == "mac" ]]; then
    brew install --cask font-hack-nerd-font
elif [[ "$PLATFORM" == "linux" ]]; then
    if fc-list 2> /dev/null | grep -qi "$FONT_NAME"; then
        echo "$FONT_NAME already installed"
        exit 0
    fi
    echo "Installing $FONT_NAME..."
    sudo apt install -y fontconfig unzip
    mkdir -p ~/.local/share/fonts
    curl -sLo /tmp/hack-nerd-font.zip \
        https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Hack.zip
    unzip -oq /tmp/hack-nerd-font.zip -d ~/.local/share/fonts
    rm /tmp/hack-nerd-font.zip
    fc-cache -f
    echo "$FONT_NAME installed successfully."
fi
