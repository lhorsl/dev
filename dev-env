#!/usr/bin/env bash
script_dir=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)
dry="0"
platform=""

while [[ $# > 0 ]]; do
	if [[ $1 == "--dry" ]]; then
		dry="1"
	elif [[ $1 == "--platform" ]]; then
		shift
		platform="$1"
	fi
	shift
done

if [[ "$platform" != "mac" && "$platform" != "linux" ]]; then
	echo "Error: --platform is required and must be 'mac' or 'linux'" >&2
	exit 1
fi

export PLATFORM="$platform"

log() {
	if [[ $dry == "1" ]]; then
	    	echo "[DRY RUN]: $@"
	else
		echo "$@"
	fi
}

execute() {
	log "execute: $@"
	if [[ $dry == "1" ]]; then
		return
	fi
	"$@"
}

# Copy the subdirectories in the dir
copy_dir() {
	local to="$2" dir
	pushd "$1"
	# -print0 into a null-delimited read, rather than word-splitting a $(find),
	# so a directory name containing whitespace stays a single argument to rm -rf.
	while IFS= read -r -d '' dir; do
		# Skip empty source dirs (e.g. an uninitialized submodule) so we never
		# wipe a live target config and replace it with nothing.
		if [[ -z "$(find "$dir" -mindepth 1 -print -quit)" ]]; then
			log "skip (empty source): $dir"
			continue
		fi
		execute rm -rf "$to/$dir"
		execute cp -r "$dir" "$to/$dir"
	done < <(find . -maxdepth 1 -mindepth 1 -type d -print0)
	popd
}
# Copy a directory and its contents
copy_all_dir() {
	local src="$1" dest="$2"

	execute mkdir -p "$dest"
	execute cp -R "$src/." "$dest/"
}

copy_file() {
	local from="$1" to="$2" name
	name="$(basename "$from")"
	execute rm -f "$to/$name"
	execute cp "$from" "$to/$name"
}

log "--------------------dev-env--------------------"

cd "$script_dir"

if [[ -z "$(find .config/nvim -mindepth 1 -print -quit 2> /dev/null)" ]]; then
	log "nvim submodule not initialised"
	execute git submodule update --init --recursive
fi

# On PATH via the .zshrc managed block, and tmux-sessionizer scans ~/repos.
execute mkdir -p ~/bin ~/.local/bin ~/.local/scripts ~/repos

copy_dir .config ~/.config
copy_all_dir .claude ~/.claude
copy_dir .local ~/.local
copy_file .ready-tmux ~
copy_file .config/tmux/.tmux.conf ~
execute env/zshrc
