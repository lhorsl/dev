#!/usr/bin/env bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

ZSHRC="$HOME/.zshrc"
ZPROFILE="$HOME/.zprofile"

# Function to check if a line exists in a file
line_exists() {
    local line="$1"
    local file="$2"
    grep -Fxq "$line" "$file" 2>/dev/null
}

# Function to add a line to a file if it doesn't exist
add_line() {
    local line="$1"
    local file="$2"
    if ! line_exists "$line" "$file"; then
        echo "$line" >> "$file"
        echo -e "${GREEN}Added to $file:${NC} $line"
    else
        echo -e "${RED}Already exists in $file:${NC} $line"
    fi
}

# Function to create file if it doesn't exist
ensure_file_exists() {
    local file="$1"
    if [ ! -f "$file" ]; then
        touch "$file"
        echo -e "${GREEN}Created file:${NC} $file"
    fi
}
# --------------------- EXECUTE -------------------
ensure_file_exists "$ZSHRC"
ensure_file_exists "$ZPROFILE"

add_line 'alias ll="ls -la"' "$ZSHRC"
add_line 'alias python="python3"' "$ZSHRC"
add_line 'alias vim="nvim"' "$ZSHRC"
add_line 'alias lg="lazygit"' "$ZSHRC"
add_line 'alias cl="claude"' "$ZSHRC"

add_line 'export PATH="$HOME/bin:$PATH"' "$ZSHRC"
add_line 'export PATH="$HOME/.local/bin:$PATH"' "$ZSHRC"
add_line 'export PATH=$PATH:$HOME/.local/scripts' "$ZSHRC"
add_line 'export PATH=$PATH:$HOME/go/bin' "$ZSHRC"

add_line 'command -v fzf > /dev/null && source <(fzf --zsh)' "$ZSHRC"
add_line 'command -v zoxide > /dev/null && eval "$(zoxide init zsh)"' "$ZSHRC"
add_line 'command -v atuin > /dev/null && eval "$(atuin init zsh)"' "$ZSHRC"

add_line 'export TMUX_SESSIONIZER_MAXDEPTH=2' "$ZSHRC"
add_line 'bindkey -s "^F" "tmux-sessionizer\n"' "$ZSHRC"

if [[ "${PLATFORM:-}" == "mac" ]]; then
    add_line '[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"' "$ZPROFILE"
    add_line '[ -x /usr/local/bin/brew ] && eval "$(/usr/local/bin/brew shellenv)"' "$ZPROFILE"

    add_line 'export PATH="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/node@22/bin:$PATH"' "$ZSHRC"
    add_line 'export PATH="$HOME/.docker/bin:$PATH"' "$ZSHRC"
fi
if [[ "${PLATFORM:-}" == "mac" ]]; then
    add_line '[ -f "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && source "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"' "$ZSHRC"
    add_line '[ -f "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && source "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"' "$ZSHRC"
else
    add_line '[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh' "$ZSHRC"
    add_line '[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh' "$ZSHRC"
fi

echo -e "\n${GREEN}Configuration complete!${NC}"
echo "To apply changes, run: exec zsh -l"
